# ===================================================================
# MCP Server Dockerfile — FastMCP (8765) + Chat FastAPI (8766)
# ===================================================================
FROM python:3.12-slim AS development
WORKDIR /app

RUN pip install uv

COPY mcp-server/ ./

RUN uv sync --no-dev || uv sync

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8765 8766

CMD ["python", "-m", "mcp_server"]

# ===================================================================
# Production stage
# ===================================================================
FROM python:3.12-slim AS production
WORKDIR /app

RUN pip install uv
COPY mcp-server/ ./
RUN uv sync --no-dev || uv sync

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8765 8766
CMD ["python", "-m", "mcp_server"]
