# Environment variables for development
# Copy this file to .env and fill in the values

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://manufactura:manufactura_dev_password@localhost:5432/manufactura_dev
# Or individual PostgreSQL settings (used if DATABASE_URL is not set)
# POSTGRES_DB=manufactura_dev
# POSTGRES_USER=manufactura
# POSTGRES_PASSWORD=manufactura_dev_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT Broker
MQTT_BROKER_URL=mqtt://manufactura:changeme@localhost:1883
MQTT_BROKER_USERNAME=manufactura
MQTT_BROKER_PASSWORD=changeme

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Channels
ASGI_APPLICATION=config.asgi
CHANNEL_LAYERS={"default": {"BACKEND": "channels.layers.InMemoryChannelLayer"}}
# For production with Redis:
# CHANNEL_LAYERS={"default": {"BACKEND": "channels_redis.core.RedisChannelLayer", "CONFIG": {"hosts": ["redis://localhost:6379/0"]}}}